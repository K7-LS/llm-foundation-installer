<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FontFamily="Segoe UI"
    Background="#F3F6FA"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True">
  <UserControl.Resources>
    <SolidColorBrush x:Key="Ink" Color="#152033" />
    <SolidColorBrush x:Key="MutedInk" Color="#5E6B7D" />
    <SolidColorBrush x:Key="Brand" Color="#4169E1" />
    <SolidColorBrush x:Key="BrandSoft" Color="#EAF0FF" />
    <SolidColorBrush x:Key="Line" Color="#DDE4EE" />
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Positive" Color="#167A58" />
    <SolidColorBrush x:Key="PositiveSoft" Color="#E7F6F0" />
    <SolidColorBrush x:Key="Warning" Color="#A15C00" />
    <SolidColorBrush x:Key="WarningSoft" Color="#FFF4DE" />

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontFamily" Value="Bahnschrift SemiBold" />
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{StaticResource MutedInk}" />
    </Style>
    <Style x:Key="TargetCard" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Surface}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="22" />
      <Setter Property="Margin" Value="0,0,16,0" />
    </Style>
    <Style x:Key="SecondaryButton" TargetType="Button">
      <Setter Property="MinHeight" Value="46" />
      <Setter Property="Padding" Value="18,0" />
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="BorderBrush" Value="#C7D1DE" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="Padding" Value="24,0" />
      <Setter Property="Background" Value="{StaticResource Brand}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Background" Value="#D8DFE9" />
          <Setter Property="Foreground" Value="#6A7688" />
          <Setter Property="Cursor" Value="Arrow" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="304" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="#111827">
      <Grid Margin="30,30,30,26">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="50" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="48" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Width="44" Height="44" CornerRadius="13" Background="#4169E1">
            <Grid>
              <Ellipse Width="20" Height="20" Stroke="#FFFFFF" StrokeThickness="2.5" />
              <Path Data="M 16,22 L 22,28 L 32,16"
                    Stroke="#FFFFFF"
                    StrokeThickness="2.5"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round" />
            </Grid>
          </Border>
          <StackPanel Grid.Column="1" Margin="12,1,0,0">
            <TextBlock Text="LLM Foundation" FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF" />
            <TextBlock Text="Установщик рабочей среды" FontSize="12" Foreground="#AAB6C8" Margin="0,3,0,0" />
          </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2">
          <TextBlock Text="КОНТУР УСТАНОВКИ" FontSize="11" FontWeight="Bold" Foreground="#7F8DA3" Margin="0,0,0,16" />

          <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border x:Name="Step1Badge" Width="32" Height="32" CornerRadius="16" Background="#4169E1" VerticalAlignment="Top">
              <TextBlock x:Name="Step1Number" Text="1" Foreground="#FFFFFF" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="4,1,0,0">
              <TextBlock x:Name="Step1Title" Text="Система" Foreground="#FFFFFF" FontSize="14" FontWeight="SemiBold" />
              <TextBlock Text="Windows и пакеты" Foreground="#93A1B6" FontSize="11" Margin="0,2,0,0" />
            </StackPanel>
          </Grid>

          <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border x:Name="Step2Badge" Width="32" Height="32" CornerRadius="16" BorderBrush="#526078" BorderThickness="1.5" VerticalAlignment="Top">
              <TextBlock x:Name="Step2Number" Text="2" Foreground="#AAB6C8" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="4,1,0,0">
              <TextBlock x:Name="Step2Title" Text="Соединение" Foreground="#C9D2DF" FontSize="14" FontWeight="SemiBold" />
              <TextBlock Text="Direct, VPN или Proxy" Foreground="#7F8DA3" FontSize="11" Margin="0,2,0,0" />
            </StackPanel>
          </Grid>

          <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border x:Name="Step3Badge" Width="32" Height="32" CornerRadius="16" BorderBrush="#526078" BorderThickness="1.5" VerticalAlignment="Top">
              <TextBlock x:Name="Step3Number" Text="3" Foreground="#AAB6C8" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="4,1,0,0">
              <TextBlock x:Name="Step3Title" Text="Клиенты" Foreground="#C9D2DF" FontSize="14" FontWeight="SemiBold" />
              <TextBlock Text="Загрузка и проверка" Foreground="#7F8DA3" FontSize="11" Margin="0,2,0,0" />
            </StackPanel>
          </Grid>

          <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border x:Name="Step4Badge" Width="32" Height="32" CornerRadius="16" BorderBrush="#526078" BorderThickness="1.5" VerticalAlignment="Top">
              <TextBlock x:Name="Step4Number" Text="4" Foreground="#AAB6C8" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="4,1,0,0">
              <TextBlock x:Name="Step4Title" Text="План баз" Foreground="#C9D2DF" FontSize="14" FontWeight="SemiBold" />
              <TextBlock Text="Управляемая поверхность" Foreground="#7F8DA3" FontSize="11" Margin="0,2,0,0" />
            </StackPanel>
          </Grid>

          <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border x:Name="Step5Badge" Width="32" Height="32" CornerRadius="16" BorderBrush="#526078" BorderThickness="1.5" VerticalAlignment="Top">
              <TextBlock x:Name="Step5Number" Text="5" Foreground="#AAB6C8" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="4,1,0,0">
              <TextBlock x:Name="Step5Title" Text="Установка" Foreground="#C9D2DF" FontSize="14" FontWeight="SemiBold" />
              <TextBlock Text="Backup, apply, doctor" Foreground="#7F8DA3" FontSize="11" Margin="0,2,0,0" />
            </StackPanel>
          </Grid>

          <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border x:Name="Step6Badge" Width="32" Height="32" CornerRadius="16" BorderBrush="#526078" BorderThickness="1.5" VerticalAlignment="Top">
              <TextBlock x:Name="Step6Number" Text="6" Foreground="#AAB6C8" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="4,1,0,0">
              <TextBlock x:Name="Step6Title" Text="Авторизация" Foreground="#C9D2DF" FontSize="14" FontWeight="SemiBold" />
              <TextBlock Text="Только в клиентах" Foreground="#7F8DA3" FontSize="11" Margin="0,2,0,0" />
            </StackPanel>
          </Grid>

          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border x:Name="Step7Badge" Width="32" Height="32" CornerRadius="16" BorderBrush="#526078" BorderThickness="1.5" VerticalAlignment="Top">
              <TextBlock x:Name="Step7Number" Text="7" Foreground="#AAB6C8" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="4,1,0,0">
              <TextBlock x:Name="Step7Title" Text="Готово" Foreground="#C9D2DF" FontSize="14" FontWeight="SemiBold" />
              <TextBlock Text="Отчёт, sync, rollback" Foreground="#7F8DA3" FontSize="11" Margin="0,2,0,0" />
            </StackPanel>
          </Grid>
        </StackPanel>

        <Border Grid.Row="3" Background="#192336" BorderBrush="#2B3850" BorderThickness="1" CornerRadius="12" Padding="16">
          <StackPanel>
            <TextBlock Text="Контур доверия" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" />
            <TextBlock Text="SHA-256 до запуска  ·  DPAPI  ·  0 телеметрии"
                       Foreground="#AAB6C8"
                       FontSize="12"
                       TextWrapping="Wrap"
                       LineHeight="18"
                       Margin="0,7,0,0" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Column="1" Margin="48,34,48,30">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="28" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Развёртывание LLM Foundation"
                     FontFamily="Bahnschrift SemiBold"
                     FontSize="30"
                     FontWeight="SemiBold" />
          <TextBlock Text="Официальные клиенты, три независимые базы и проверяемый откат — в одном контуре."
                     FontSize="14"
                     Foreground="{StaticResource MutedInk}"
                     Margin="0,8,0,0" />
        </StackPanel>
        <Border Grid.Column="1" Background="{StaticResource PositiveSoft}" CornerRadius="18" Padding="14,8" VerticalAlignment="Top">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" Fill="{StaticResource Positive}" Margin="0,0,8,0" />
            <TextBlock Text="VERIFIED SOURCES  ·  CURRENT USER" Foreground="{StaticResource Positive}" FontSize="12" FontWeight="Bold" />
          </StackPanel>
        </Border>
      </Grid>

      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Компоненты" Style="{StaticResource SectionTitle}" />
              <TextBlock Text="Каждая база устанавливается нативно и обновляется независимо."
                         Style="{StaticResource Caption}"
                         Margin="0,6,0,0" />
            </StackPanel>
            <Button x:Name="RefreshEnvironment" Grid.Column="1" Content="Повторить проверку" Style="{StaticResource SecondaryButton}" />
          </Grid>

          <UniformGrid Columns="3" Margin="0,0,0,26">
            <Border Style="{StaticResource TargetCard}">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Border Width="44" Height="44" Background="#E8EEFF" CornerRadius="12">
                    <TextBlock Text="C" Foreground="#3157C7" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1" Margin="10,1,0,0">
                    <TextBlock Text="Codex" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="OpenAI" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                  </StackPanel>
                  <CheckBox x:Name="CodexSelected" Grid.Column="2" Content="Установить" MinWidth="100" Height="28" IsEnabled="False" VerticalAlignment="Top" />
                </Grid>
                <TextBlock Grid.Row="1"
                           Text="Компактный HOT-слой, 16 агентов и 37 навыков по требованию."
                           TextWrapping="Wrap"
                           Foreground="{StaticResource MutedInk}"
                           FontSize="13"
                           LineHeight="19"
                           Margin="0,18,0,16" />
                <Border x:Name="CodexStatusBadge" Grid.Row="2" Background="{StaticResource WarningSoft}" CornerRadius="10" Padding="11,8">
                  <TextBlock x:Name="CodexStatus" Text="Пакет не добавлен" Foreground="{StaticResource Warning}" FontSize="12" FontWeight="SemiBold" />
                </Border>
              </Grid>
            </Border>

            <Border Style="{StaticResource TargetCard}">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Border Width="44" Height="44" Background="#FFF0E6" CornerRadius="12">
                    <TextBlock Text="A" Foreground="#B14E16" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1" Margin="10,1,0,0">
                    <TextBlock Text="Claude" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="Anthropic" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                  </StackPanel>
                  <CheckBox x:Name="ClaudeSelected" Grid.Column="2" Content="Установить" MinWidth="100" Height="28" IsEnabled="False" VerticalAlignment="Top" />
                </Grid>
                <TextBlock Grid.Row="1"
                           Text="Короткий CLAUDE.md; подробные правила, skills и agents загружаются по контексту."
                           TextWrapping="Wrap"
                           Foreground="{StaticResource MutedInk}"
                           FontSize="13"
                           LineHeight="19"
                           Margin="0,18,0,16" />
                <Border x:Name="ClaudeStatusBadge" Grid.Row="2" Background="{StaticResource WarningSoft}" CornerRadius="10" Padding="11,8">
                  <TextBlock x:Name="ClaudeStatus" Text="Пакет не добавлен" Foreground="{StaticResource Warning}" FontSize="12" FontWeight="SemiBold" />
                </Border>
              </Grid>
            </Border>

            <Border Style="{StaticResource TargetCard}" Margin="0">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Border Width="44" Height="44" Background="#E7F6F0" CornerRadius="12">
                    <TextBlock Text="O" Foreground="#137655" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1" Margin="10,1,0,0">
                    <TextBlock Text="OpenCode" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="Provider-neutral" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                  </StackPanel>
                  <CheckBox x:Name="OpenCodeSelected" Grid.Column="2" Content="Установить" MinWidth="100" Height="28" IsEnabled="False" VerticalAlignment="Top" />
                </Grid>
                <TextBlock Grid.Row="1"
                           Text="Нативные agents, commands и skills; провайдер и модель выбираются пользователем."
                           TextWrapping="Wrap"
                           Foreground="{StaticResource MutedInk}"
                           FontSize="13"
                           LineHeight="19"
                           Margin="0,18,0,16" />
                <Border x:Name="OpenCodeStatusBadge" Grid.Row="2" Background="{StaticResource WarningSoft}" CornerRadius="10" Padding="11,8">
                  <TextBlock x:Name="OpenCodeStatus" Text="Пакет не добавлен" Foreground="{StaticResource Warning}" FontSize="12" FontWeight="SemiBold" />
                </Border>
              </Grid>
            </Border>
          </UniformGrid>

          <Border Background="#FFFFFF"
                  BorderBrush="{StaticResource Line}"
                  BorderThickness="1"
                  CornerRadius="16"
                  Padding="22"
                  Margin="0,0,0,20">
            <StackPanel>
              <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Соединение" FontSize="17" FontWeight="SemiBold" />
                  <TextBlock Text="Режим используется для загрузки официальных клиентов и для $sync-base. Пакеты баз уже проверены и встроены."
                             Style="{StaticResource Caption}"
                             Margin="0,5,0,0" />
                  <TextBlock Text="VPN/Proxy — это только транспорт: режим не подтверждает доступность сервиса в регионе и не используется для обхода ограничений."
                             TextWrapping="Wrap"
                             Foreground="{StaticResource Warning}"
                             FontSize="11"
                             Margin="0,5,20,0" />
                </StackPanel>
                <Border Grid.Column="1"
                        Background="{StaticResource BrandSoft}"
                        CornerRadius="13"
                        Padding="11,6"
                        VerticalAlignment="Top">
                  <TextBlock Text="VPN ≠ PROXY"
                             Foreground="#3157C7"
                             FontSize="11"
                             FontWeight="Bold" />
                </Border>
              </Grid>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="130" />
                  <ColumnDefinition Width="130" />
                  <ColumnDefinition Width="130" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Column="0" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,8,0">
                  <RadioButton x:Name="DirectMode" GroupName="ConnectionMode" Content="Direct" FontWeight="SemiBold" IsChecked="True" />
                </Border>
                <Border Grid.Column="1" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,8,0">
                  <RadioButton x:Name="VpnMode" GroupName="ConnectionMode" Content="VPN" FontWeight="SemiBold" ToolTip="VPN — самостоятельный режим, прокси не требуется." />
                </Border>
                <Border Grid.Column="2" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="12,10">
                  <RadioButton x:Name="ProxyMode" GroupName="ConnectionMode" Content="Proxy" FontWeight="SemiBold" />
                </Border>

                <Grid x:Name="ProxySettings"
                      Grid.Row="1"
                      Grid.ColumnSpan="4"
                      Margin="0,12,0,0"
                      IsEnabled="False">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="82" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="130" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="Тип прокси" Style="{StaticResource Caption}" FontSize="11" Margin="2,0,0,4" ToolTip="При смене типа замените также сервер и порт" />
                  <TextBlock Grid.Row="0" Grid.Column="1" Text="Сервер" Style="{StaticResource Caption}" FontSize="11" Margin="2,0,0,4" />
                  <TextBlock Grid.Row="0" Grid.Column="2" Text="Порт" Style="{StaticResource Caption}" FontSize="11" Margin="2,0,0,4" />
                  <TextBlock Grid.Row="0" Grid.Column="3" Text="Авторизация" Style="{StaticResource Caption}" FontSize="11" Margin="2,0,0,4" />
                  <TextBlock Grid.Row="0" Grid.Column="4" Text="Логин" Style="{StaticResource Caption}" FontSize="11" Margin="2,0,0,4" />
                  <TextBlock Grid.Row="0" Grid.Column="5" Text="Пароль" Style="{StaticResource Caption}" FontSize="11" Margin="2,0,0,4" />
                  <ComboBox x:Name="ProxyType" Grid.Row="1" Grid.Column="0" Height="38" SelectedIndex="1" Margin="0,0,8,0" ToolTip="Протокол самого прокси-сервера, не открываемого сайта">
                    <ComboBoxItem Content="HTTP" Tag="HTTP" />
                    <ComboBoxItem Content="HTTPS" Tag="HTTPS" />
                    <ComboBoxItem Content="SOCKS5" Tag="SOCKS5" />
                  </ComboBox>
                  <TextBox x:Name="ProxyHost" Grid.Row="1" Grid.Column="1" Height="38" Padding="10,7" Margin="0,0,8,0" ToolTip="DNS, IPv4 или IPv6 без схемы" />
                  <TextBox x:Name="ProxyPort" Grid.Row="1" Grid.Column="2" Height="38" Padding="10,7" Margin="0,0,8,0" ToolTip="Порт" />
                  <ComboBox x:Name="ProxyAuth" Grid.Row="1" Grid.Column="3" Height="38" SelectedIndex="0" Margin="0,0,8,0">
                    <ComboBoxItem Content="Без авторизации" Tag="None" />
                    <ComboBoxItem Content="Логин и пароль" Tag="UsernamePassword" />
                  </ComboBox>
                  <TextBox x:Name="ProxyUsername" Grid.Row="1" Grid.Column="4" Height="38" Padding="10,7" Margin="0,0,8,0" IsEnabled="False" ToolTip="Логин" />
                  <PasswordBox x:Name="ProxyPassword" Grid.Row="1" Grid.Column="5" Height="38" Padding="10,7" IsEnabled="False" ToolTip="Пароль защищается Windows DPAPI" />
                </Grid>
              </Grid>

              <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ConnectionStatus"
                           Text="Direct: прокси не используется."
                           Foreground="{StaticResource Positive}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Button x:Name="TestConnection"
                        Grid.Column="1"
                        Content="Сохранить и проверить"
                        Style="{StaticResource SecondaryButton}"
                        MinHeight="38"
                        Margin="0,0,8,0" />
                <Button x:Name="SaveConnection"
                        Grid.Column="2"
                        Content="Сохранить соединение"
                        Style="{StaticResource SecondaryButton}"
                        MinHeight="38" />
              </Grid>
            </StackPanel>
          </Border>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="18" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16" Padding="22">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="44" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource BrandSoft}" VerticalAlignment="Top">
                  <Path Data="M 10,17 L 15,22 L 26,11" Stroke="#4169E1" StrokeThickness="2.4"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                  <TextBlock Text="Данные пользователя сохраняются" FontSize="16" FontWeight="SemiBold" />
                  <TextBlock Text="Авторизация клиентов, сессии, память, проекты, состояние браузера и рабочие папки не входят в управляемую поверхность."
                             TextWrapping="Wrap"
                             Foreground="{StaticResource MutedInk}"
                             FontSize="13"
                             LineHeight="19"
                             Margin="0,8,0,0" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16" Padding="22">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="44" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="36" Height="36" CornerRadius="10" Background="#EEF2F7" VerticalAlignment="Top">
                  <Grid>
                    <Ellipse Width="18" Height="18" Stroke="#536173" StrokeThickness="2" />
                    <Path Data="M 18,9 L 18,18 L 24,21" Stroke="#536173" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                  </Grid>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                  <TextBlock Text="Восстановление встроено" FontSize="16" FontWeight="SemiBold" />
                  <TextBlock Text="Перед изменениями создаётся полный backup. Ошибка doctor запускает автоматический rollback."
                             TextWrapping="Wrap"
                             Foreground="{StaticResource MutedInk}"
                             FontSize="13"
                             LineHeight="19"
                             Margin="0,8,0,0" />
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </StackPanel>
      </ScrollViewer>

      <Grid Grid.Row="3" Margin="0,22,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border x:Name="StatusBanner" Background="{StaticResource WarningSoft}" CornerRadius="10" Padding="14,10" Margin="0,0,18,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
          <TextBlock x:Name="StatusText"
                     Text="Установка заблокирована: нет принятых target-пакетов."
                     Foreground="{StaticResource Warning}"
                     FontSize="13"
                     FontWeight="SemiBold"
                     TextWrapping="Wrap"
                     VerticalAlignment="Center" />
            <ProgressBar x:Name="InstallProgress"
                         Grid.Row="1"
                         Height="4"
                         Margin="0,9,0,0"
                         Minimum="0"
                         Maximum="100"
                         Value="0"
                         Visibility="Collapsed"
                         Foreground="{StaticResource Brand}"
                         Background="#DDE4EE" />
          </Grid>
        </Border>
        <Button x:Name="PrimaryAction"
                Grid.Column="1"
                Content="Сформировать план"
                Style="{StaticResource PrimaryButton}"
                IsEnabled="False" />
      </Grid>
    </Grid>
  </Grid>
</UserControl>
