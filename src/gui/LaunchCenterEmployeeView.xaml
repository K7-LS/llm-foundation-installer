<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FontFamily="Segoe UI"
    Background="#F6F7F5"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True">
  <UserControl.Resources>
    <SolidColorBrush x:Key="Ink" Color="#071E22" />
    <SolidColorBrush x:Key="Orange" Color="#FC4912" />
    <SolidColorBrush x:Key="Mint" Color="#77CBB9" />
    <SolidColorBrush x:Key="Blue" Color="#30BCED" />
    <SolidColorBrush x:Key="Line" Color="#D7DFDE" />
    <SolidColorBrush x:Key="Muted" Color="#627275" />
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Ink}" /></Style>
    <Style x:Key="RouteButton" TargetType="RadioButton">
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="FontFamily" Value="Cascadia Mono" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style x:Key="StatusCard" TargetType="Border">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="Padding" Value="15" />
    </Style>
    <Style x:Key="ClientListItem" TargetType="ListBoxItem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="SelectionFrame" BorderBrush="Transparent" BorderThickness="2" CornerRadius="17" Padding="3">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="SelectionFrame" Property="BorderBrush" Value="#77CBB9" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="SelectionFrame" Property="BorderBrush" Value="#FC4912" />
                <Setter TargetName="SelectionFrame" Property="Background" Value="#FFF0E9" />
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="SelectionFrame" Property="BorderBrush" Value="#30BCED" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="238" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="{StaticResource Ink}">
      <Grid Margin="26">
        <Grid.RowDefinitions><RowDefinition Height="148" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Viewbox Width="164" Height="108" HorizontalAlignment="Left" VerticalAlignment="Top">
          <Canvas Width="305" Height="200">
            <Rectangle Canvas.Left="160" Width="145" Height="40" Fill="#FFFFFF" />
            <Path Fill="#FFFFFF" Data="M40,0v83.81c-1.06,1-2.1,2.01-3.14,3.05-14.69,14.7-26.22,31.8-34.28,50.85-.91,2.15-1.77,4.31-2.57,6.48V0h40Z" />
            <Path Fill="#FFFFFF" Data="M144.91,200h-50l-32.38-48.57c4.47-8.02,10.08-15.48,16.76-22.15,3.69-3.69,7.62-7.06,11.75-10.09l53.86,80.8Z" />
            <Path Fill="#FC4912" Data="M305,50v40c-29.38,0-57,11.44-77.78,32.22-20.78,20.78-32.22,48.4-32.22,77.78h-40c0-82.84,67.16-150,150-150Z" />
            <Path Fill="#FC4912" Data="M150,50v40c-29.38,0-57,11.44-77.78,32.22-20.78,20.78-32.22,48.4-32.22,77.78H0C0,117.16,67.16,50,150,50Z" />
          </Canvas>
        </Viewbox>
        <StackPanel Grid.Row="1">
          <TextBlock Text="ЦЕНТР ЗАПУСКА ИИ" FontFamily="Cascadia Mono" FontSize="11" FontWeight="Bold" Foreground="#77CBB9" />
          <TextBlock Text="Рабочий старт" FontFamily="Bahnschrift SemiCondensed" FontSize="27" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,5,0,0" />
          <TextBlock Text="Клиент + маршрут — одним действием" Foreground="#B8C8C8" TextWrapping="Wrap" Margin="0,5,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,34,0,0">
          <TextBlock Text="КАК ЭТО РАБОТАЕТ" FontFamily="Cascadia Mono" FontSize="10" Foreground="#77CBB9" />
          <TextBlock Text="01  Выберите клиент" Foreground="#FFFFFF" Margin="0,14,0,0" />
          <Border Width="2" Height="26" Background="#30BCED" HorizontalAlignment="Left" Margin="7,5,0,5" />
          <TextBlock Text="02  Укажите маршрут" Foreground="#FFFFFF" />
          <Border Width="2" Height="26" Background="#FC4912" HorizontalAlignment="Left" Margin="7,5,0,5" />
          <TextBlock Text="03  Запустите" Foreground="#FFFFFF" />
        </StackPanel>
        <TextBlock Grid.Row="3" Text="K-7 · ВЕРСИЯ ДЛЯ СОТРУДНИКОВ" FontFamily="Cascadia Mono" FontSize="10" Foreground="#77CBB9" />
      </Grid>
    </Border>

    <Grid Grid.Column="1" Margin="36,30">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="ГОТОВО К РАБОТЕ / 01" FontFamily="Cascadia Mono" FontSize="11" Foreground="{StaticResource Muted}" />
          <TextBlock Text="Что запускаем сегодня?" FontFamily="Bahnschrift SemiCondensed" FontSize="31" FontWeight="SemiBold" Margin="0,5,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
          <Button x:Name="OpenGuideDashboard" Content="Инструкция" Height="34" Padding="14,0" Margin="0,0,9,0" Background="#FFFFFF" Foreground="#071E22" BorderBrush="#D7DFDE" BorderThickness="1" FontWeight="SemiBold" />
          <Border Background="#E3F4F0" CornerRadius="18" Padding="14,7">
            <TextBlock Text="● ЛОКАЛЬНО ГОТОВО" Foreground="#146B5A" FontFamily="Cascadia Mono" FontSize="11" FontWeight="Bold" />
          </Border>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1" Margin="0,30,0,24">
        <Grid.ColumnDefinitions><ColumnDefinition Width="5*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="4*" /></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Text="ВЫБЕРИТЕ КЛИЕНТА" FontFamily="Cascadia Mono" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,10" />
          <ListBox x:Name="LaunchTargetList" Background="Transparent" BorderThickness="0" SelectedIndex="0">
            <ListBoxItem Tag="codex-desktop" Style="{StaticResource ClientListItem}" Padding="0" Margin="0,0,0,12">
              <Border Background="#FFFFFF" BorderBrush="#30BCED" BorderThickness="2" CornerRadius="14" Padding="20">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="54" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <Border Width="44" Height="44" CornerRadius="22" Background="#DFF5FC"><TextBlock Text="C" FontFamily="Bahnschrift SemiCondensed" FontSize="22" FontWeight="Bold" Foreground="#137A9D" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                  <StackPanel Grid.Column="1" Margin="13,0,0,0"><TextBlock Text="OpenAI Codex" FontFamily="Bahnschrift SemiCondensed" FontSize="21" FontWeight="SemiBold" /><TextBlock Text="Код, репозитории, автоматизация" Foreground="{StaticResource Muted}" Margin="0,3,0,0" /></StackPanel>
                  <TextBlock Grid.Column="2" Text="ГОТОВО" FontFamily="Cascadia Mono" FontSize="10" Foreground="#146B5A" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </ListBoxItem>
            <ListBoxItem Tag="codex-cli" Style="{StaticResource ClientListItem}" Padding="0" Margin="0,0,0,12">
              <Border Background="#FFFFFF" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="16">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="54" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <Border Width="44" Height="44" CornerRadius="22" Background="#DFF5FC"><TextBlock Text="&gt;_" FontFamily="Cascadia Mono" FontSize="16" FontWeight="Bold" Foreground="#137A9D" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                  <StackPanel Grid.Column="1" Margin="13,0,0,0"><TextBlock Text="Codex CLI" FontFamily="Bahnschrift SemiCondensed" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="Запуск в терминале" Foreground="{StaticResource Muted}" Margin="0,3,0,0" /></StackPanel>
                  <TextBlock Grid.Column="2" Text="ГОТОВО" FontFamily="Cascadia Mono" FontSize="10" Foreground="#146B5A" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </ListBoxItem>
            <ListBoxItem Tag="vscode-codex" Style="{StaticResource ClientListItem}" Padding="0" Margin="0,0,0,12">
              <Border Background="#FFFFFF" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="16">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="54" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <Border Width="44" Height="44" CornerRadius="22" Background="#DFF5FC"><TextBlock Text="VS" FontFamily="Bahnschrift SemiCondensed" FontSize="17" FontWeight="Bold" Foreground="#137A9D" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                  <StackPanel Grid.Column="1" Margin="13,0,0,0"><TextBlock Text="VS Code — Codex" FontFamily="Bahnschrift SemiCondensed" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="Локальный ID: OpenAI.chatgpt" Foreground="{StaticResource Muted}" Margin="0,3,0,0" /></StackPanel>
                  <TextBlock Grid.Column="2" Text="ПРОВЕРКА" FontFamily="Cascadia Mono" FontSize="10" Foreground="#137A9D" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </ListBoxItem>
            <ListBoxItem Tag="opencode-desktop" Style="{StaticResource ClientListItem}" Padding="0" Margin="0,0,0,12">
              <Border Background="#FFFFFF" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="16">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="54" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <Border Width="44" Height="44" CornerRadius="22" Background="#E3F4F0"><TextBlock Text="O" FontFamily="Bahnschrift SemiCondensed" FontSize="22" FontWeight="Bold" Foreground="#146B5A" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                  <StackPanel Grid.Column="1" Margin="13,0,0,0"><TextBlock Text="OpenCode Desktop" FontFamily="Bahnschrift SemiCondensed" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="Графический клиент" Foreground="{StaticResource Muted}" Margin="0,3,0,0" /></StackPanel>
                  <TextBlock Grid.Column="2" Text="ГОТОВО" FontFamily="Cascadia Mono" FontSize="10" Foreground="#146B5A" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </ListBoxItem>
            <ListBoxItem Tag="opencode-cli" Style="{StaticResource ClientListItem}" Padding="0">
              <Border Background="#FFFFFF" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="20">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="54" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <Border Width="44" Height="44" CornerRadius="22" Background="#E3F4F0"><TextBlock Text="O" FontFamily="Bahnschrift SemiCondensed" FontSize="22" FontWeight="Bold" Foreground="#146B5A" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                  <StackPanel Grid.Column="1" Margin="13,0,0,0"><TextBlock Text="OpenCode CLI" FontFamily="Bahnschrift SemiCondensed" FontSize="21" FontWeight="SemiBold" /><TextBlock Text="Запуск в терминале" Foreground="{StaticResource Muted}" Margin="0,3,0,0" /></StackPanel>
                  <TextBlock Grid.Column="2" Text="ГОТОВО" FontFamily="Cascadia Mono" FontSize="10" Foreground="#146B5A" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </ListBoxItem>
          </ListBox>
        </StackPanel>

        <StackPanel Grid.Column="2">
          <TextBlock Text="МАРШРУТ" FontFamily="Cascadia Mono" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,10" />
          <Border Style="{StaticResource StatusCard}">
            <StackPanel>
              <RadioButton x:Name="RouteDirect" GroupName="Route" Content="Напрямую" IsChecked="True" Style="{StaticResource RouteButton}" />
              <RadioButton x:Name="RouteVpn" GroupName="Route" Content="VPN" Style="{StaticResource RouteButton}" Margin="0,8,0,0" />
              <RadioButton x:Name="RouteHttp" GroupName="Route" Content="SingBox HTTP" Style="{StaticResource RouteButton}" Margin="0,8,0,0" />
              <RadioButton x:Name="RouteHttps" GroupName="Route" Content="SingBox HTTPS" Style="{StaticResource RouteButton}" Margin="0,8,0,0" />
              <Grid x:Name="ProxySettings" Visibility="Collapsed" Margin="0,16,0,0">
                <StackPanel>
                  <TextBlock Text="НАСТРОЙКИ SING-BOX" FontFamily="Cascadia Mono" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,0,0,8" />
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="75" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="Сервер" FontSize="11" Foreground="{StaticResource Muted}" /><TextBox x:Name="ProxyHost" Height="32" Margin="0,4,8,0" /></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="Порт" FontSize="11" Foreground="{StaticResource Muted}" /><TextBox x:Name="ProxyPort" Height="32" Margin="0,4,8,0" /></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="Логин" FontSize="11" Foreground="{StaticResource Muted}" /><TextBox x:Name="ProxyUsername" Height="32" Margin="0,4,8,0" /></StackPanel>
                    <StackPanel Grid.Column="3"><TextBlock Text="Пароль" FontSize="11" Foreground="{StaticResource Muted}" /><PasswordBox x:Name="ProxyPassword" Height="32" Margin="0,4,0,0" /></StackPanel>
                  </Grid>
                  <TextBlock Text="1. Заполните данные. 2. Нажмите «Сохранить и проверить». 3. Запустите клиент. Launch Center сам запускает и останавливает sing-box; отдельный скрипт не нужен." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0" />
                  <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="SaveConnection" Content="Сохранить" Padding="10,6" />
                    <Button x:Name="TestConnection" Content="Сохранить и проверить" Padding="10,6" Margin="8,0,0,0" />
                    <Button x:Name="StopRoute" Content="Остановить маршрут" Padding="10,6" Margin="8,0,0,0" IsEnabled="False" />
                  </StackPanel>
                  <TextBlock x:Name="ConnectionStatus" Text="Выберите маршрут подключения." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,8,0,0" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>
          <Border Background="#071E22" CornerRadius="11" Padding="16" Margin="0,15,0,0">
            <StackPanel>
              <TextBlock Text="ПУТЬ СИГНАЛА" FontFamily="Cascadia Mono" FontSize="10" Foreground="#77CBB9" />
              <TextBlock x:Name="SelectedClientName" Text="Codex" Foreground="#FFFFFF" Margin="0,11,0,0" />
              <Border Height="3" Background="#FC4912" CornerRadius="2" Margin="0,8,0,8" />
              <TextBlock x:Name="SelectedRouteName" Text="Прямое подключение" Foreground="#C3D0D1" />
            </StackPanel>
          </Border>
          <TextBlock x:Name="LaunchGuidance" Visibility="Collapsed" TextWrapping="Wrap" Foreground="#9B3A1C" FontSize="11" Margin="0,12,0,0" />
          <Button x:Name="LaunchOfficialLink" Visibility="Collapsed" Content="Открыть страницу OpenAI.chatgpt →" HorizontalAlignment="Left" Padding="12,7" Margin="0,8,0,0" />
        </StackPanel>
      </Grid>

      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Border Grid.Column="0" Style="{StaticResource StatusCard}" Margin="0,0,9,0"><StackPanel><TextBlock Text="МАРШРУТ" FontFamily="Cascadia Mono" FontSize="9" Foreground="{StaticResource Muted}" /><TextBlock x:Name="RouteStatus" Text="Напрямую · готово" FontWeight="SemiBold" Margin="0,4,0,0" /></StackPanel></Border>
          <Border Grid.Column="1" Style="{StaticResource StatusCard}" Margin="0,0,9,0"><StackPanel><TextBlock Text="ПРОВЕРКА" FontFamily="Cascadia Mono" FontSize="9" Foreground="{StaticResource Muted}" /><TextBlock x:Name="EvidenceStatus" Text="Пакет проверен" FontWeight="SemiBold" Margin="0,4,0,0" /></StackPanel></Border>
          <Border Grid.Column="2" Style="{StaticResource StatusCard}"><StackPanel><TextBlock Text="ВОССТАНОВЛЕНИЕ" FontFamily="Cascadia Mono" FontSize="9" Foreground="{StaticResource Muted}" /><TextBlock x:Name="RollbackStatus" Text="Доступно" FontWeight="SemiBold" Margin="0,4,0,0" /></StackPanel></Border>
        </Grid>
        <Button x:Name="LaunchSelected" Grid.Column="1" Content="Запустить Codex  →" Height="56" Padding="26,0" Margin="18,0,0,0" Background="#FC4912" Foreground="#FFFFFF" BorderThickness="0" FontFamily="Bahnschrift SemiCondensed" FontSize="18" FontWeight="SemiBold" />
      </Grid>
    </Grid>
  </Grid>
</UserControl>
