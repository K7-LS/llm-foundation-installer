<?xml version="1.0" encoding="utf-8"?>
<!-- Проект не имеет ни одного PackageReference: implicit restore каждой
     dotnet build ходил в nuget.org впустую (через прокси — медленно и
     нестабильно; десятки сборок за тестовый прогон). Пустой список
     источников делает restore полностью локальным и без сети. -->
<configuration>
  <packageSources>
    <clear />
  </packageSources>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
</configuration>
